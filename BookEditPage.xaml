<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab3.BookEditPage"
             Title="Book">
    <VerticalStackLayout Padding="20" Spacing="10" MaximumWidthRequest="500">
        <Entry x:Name="TitleEntry" Placeholder="Title"/>
        <Entry x:Name="AuthorEntry" Placeholder="Author"/>
        <Entry x:Name="GenreEntry" Placeholder="Genre"/>
        <Entry x:Name="YearEntry" Placeholder="Year" Keyboard="Numeric"/>
        <Entry x:Name="PagesEntry" Placeholder="Pages" Keyboard="Numeric"/>
        <Entry x:Name="PriceEntry" Placeholder="Price" Keyboard="Numeric"/>
        <HorizontalStackLayout Spacing="10">
            <Button Text="OK" Clicked="OnOk"/>
            <Button Text="Cancel" Clicked="OnCancel"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>